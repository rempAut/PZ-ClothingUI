{
    "Lua.diagnostics.globals": [
        "Events",
        "getFileReader",
        "getFileWriter",
        "getCore",
        "ISPanel",
        "ISButton",
        "ISCollapsableWindow",
        "UIFont",
        "UIManager",
        "getPlayer",
        "ISContextMenu",
        "ISInventoryPaneContextMenu",
        "getTextManager"
    ],
    "Lua.workspace.library": [
        "${addons}/umbrella-unstable/module/library"
    ],
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.path": [
        "?.lua",
        "?/init.lua",
        "server/?.lua"
    ],
    "Lua.completion.requireSeparator": "/",
    "Lua.runtime.builtin": {
        "debug": "disable",
        "io": "disable",
        "package": "disable"
    },
    "Lua.workspace.checkThirdParty": false
}